# ---- .env.example  (commit this; copy to .env and fill in; never commit .env) ----
AWS_REGION=us-west-2
AWS_PROFILE=
GITHUB_BOT_TOKEN=              # machine token used by the RepoTools and CI Lambdas
GITHUB_OAUTH_CLIENT_ID=        # GitHub OAuth app, for PRs as the developer
GITHUB_OAUTH_CLIENT_SECRET=
TRACKER_API_KEY=
COGNITO_DISCOVERY_URL=
COGNITO_CLIENT_ID=
PITWALL_RUNTIME_ARN=          # filled in after first deploy
MEMORY_ID=                     # filled in after Module 4
GATEWAY_URL=                   # filled in after Module 5

